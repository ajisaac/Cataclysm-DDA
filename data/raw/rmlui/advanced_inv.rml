<rml>
<head>
    <title>Advanced Inventory Management</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
    <style>
        /* The advanced inventory; see advanced_inventory in
           src/advanced_inv.cpp. Each pane builds one page of items, of a
           height set in code. */
        #header
        {
            padding-bottom: 6dp;
            border-bottom: 1dp #39465c;
        }
        .aim-messages
        {
            min-width: 0;
        }
        .aim-side
        {
            margin: 0 12dp;
            text-align: right;
        }
        #aim-minimap
        {
            flex: 0 0 auto;
            padding: 2dp 6dp;
            border: 1dp #39465c;
            border-radius: 3dp;
            font-family: cata-mono;
            text-align: center;
        }
        .aim-minimap-all
        {
            font-size: 12dp;
        }
        .aim-minimap-row span
        {
            display: inline-block;
            width: 1.2em;
        }

        .aim-pane
        {
            display: flex;
            flex-direction: column;
            border: 1dp #2a3242;
            border-radius: 4dp;
            padding: 4dp 8dp;
        }
        .aim-pane + .aim-pane
        {
            margin-left: 8dp;
        }
        .aim-pane.active
        {
            border-color: #5a7aa8;
        }
        .aim-top, .aim-where, .aim-info
        {
            align-items: center;
        }
        .aim-where-text
        {
            min-width: 0;
        }
        .aim-keys
        {
            flex: 0 0 auto;
            margin-left: 8dp;
            font-family: cata-mono;
        }
        .aim-keys .line
        {
            white-space: pre;
        }
        .aim-key:hover
        {
            background-color: #2b3a52;
        }
        .aim-info
        {
            margin-top: 2dp;
        }
        .aim-list
        {
            overflow: hidden;
        }
        .aim-row
        {
            display: flex;
            align-items: center;
            padding: 0 4dp;
            border-radius: 3dp;
        }
        .aim-row:hover
        {
            background-color: #232b3a;
        }
        .aim-row.selected
        {
            background-color: #2b3a52;
        }
        .aim-row.selected.aim-catmode
        {
            background-color: #5a2b2b;
        }
        .aim-row.aim-other
        {
            background-color: #4a3a1c;
        }
        .aim-row.aim-titles
        {
            border-bottom: 1dp #39465c;
        }
        .aim-row.aim-titles:hover
        {
            background-color: transparent;
        }
        .aim-mark
        {
            flex: 0 0 auto;
            width: 1em;
        }
        .aim-name
        {
            flex: 1 1 auto;
            min-width: 0;
            overflow: hidden;
        }
        /* The numbers, lined up in a fixed-width font as the terminal had
           them, with the column titles above. */
        .aim-nums
        {
            flex: 0 0 auto;
            margin-left: 8dp;
            font-family: cata-mono;
            white-space: pre;
            text-align: right;
        }
        .aim-cat
        {
            text-align: center;
        }
        .aim-bottom
        {
            margin-top: 4dp;
        }
        .aim-bottom .button
        {
            margin-bottom: 0;
        }
    </style>
</head>
<body>
    <!-- Filled in by advanced_inventory in src/advanced_inv.cpp. -->
    <div id="root">
        <div id="window">
            <div id="titlebar">
                <div id="title"></div>
                <div id="close" data-action="QUIT">×</div>
            </div>
            <div id="tabs" class="hidden"></div>
            <div id="header" class="hidden"></div>
            <div id="body"></div>
            <div id="filter-row" class="hidden">
                <input type="text" id="filter" class="text" disabled="disabled"/>
            </div>
            <div id="footer" class="hidden"></div>
        </div>
    </div>
</body>
</rml>
