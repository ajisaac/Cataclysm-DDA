<rml>
<head>
    <title>Construction</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
    <style>
        /* The construction menu, along the bottom of the screen; see construction_menu() in src/construction.cpp. The constructions on the left, the selected one's stages on the right. */
        .con-left
        {
            flex: 3 1 0;
            display: flex;
            flex-direction: column;
        }
        .con-right
        {
            flex: 5 1 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .con-category
        {
            flex: 0 0 auto;
            margin-bottom: 4dp;
            text-align: center;
        }
        .con-category .button
        {
            margin: 0 8dp;
        }
        #con-list
        {
            flex: 1 1 0;
            min-height: 0;
            overflow-y: auto;
        }
        .con-name
        {
            flex: 0 0 auto;
            margin-bottom: 4dp;
        }
        #con-stages
        {
            flex: 1 1 0;
            min-height: 0;
            overflow-y: auto;
        }
        .con-stage + .con-stage
        {
            margin-top: 8dp;
            padding-top: 6dp;
            border-top: 1dp #2a3242;
        }
        .con-notes
        {
            flex: 0 0 auto;
            margin-top: 6dp;
            padding-top: 4dp;
            border-top: 1dp #39465c;
        }
    </style>
</head>
<body>
    <!-- Filled in by construction_menu() in src/construction.cpp. -->
    <div id="root">
        <div id="window">
            <div id="titlebar">
                <div id="title"></div>
                <div id="close" data-action="QUIT">×</div>
            </div>
            <div id="tabs" class="hidden"></div>
            <div id="header" class="hidden"></div>
            <div id="body"></div>
            <div id="filter-row" class="hidden">
                <input type="text" id="filter" disabled="disabled"/>
            </div>
            <div id="footer" class="hidden"></div>
        </div>
    </div>
</body>
</rml>
