<rml>
<head>
    <title>The End</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
    <style>
        /* The picture is monospace, a line to an em and a column to half an
           em, so the info end_screen_ui_impl lays over it lands on the column
           and row it asks for. */
        .art
        {
            position: relative;
            font-family: cata-mono;
        }
        .art-line
        {
            height: 1em;
            line-height: 1em;
            white-space: pre;
        }
        .art-info
        {
            position: absolute;
            line-height: 1em;
            white-space: pre;
        }
        #last-words-row
        {
            margin-top: 6dp;
        }
        #last-words-row.hidden
        {
            display: none;
        }
    </style>
</head>
<body>
    <div id="root">
        <div id="window">
            <div id="titlebar">
                <div id="title"></div>
                <div id="close" data-action="QUIT">×</div>
            </div>
            <div id="tabs" class="hidden"></div>
            <div id="header" class="hidden"></div>
            <div id="body"></div>
            <div id="filter-row" class="hidden">
                <input type="text" id="filter" disabled="disabled"/>
            </div>
            <div id="footer" class="hidden"></div>
            <div id="last-words-row" class="hidden">
                <input type="text" id="last-words"/>
            </div>
        </div>
    </div>
</body>
</rml>
