<rml>
<head>
    <title>Input popup</title>
    <link type="text/rcss" href="common.rcss"/>
    <style>
        #root
        {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #popup
        {
            max-width: 720dp;
            padding: 16dp 20dp;
            background-color: #141821f2;
            border: 1dp #39465c;
            border-radius: 8dp;
        }
        .hidden
        {
            display: none;
        }
        #title
        {
            font-size: 18dp;
            color: #ffffff;
            margin-bottom: 10dp;
        }
        /* Game text lines up with spaces, so keep them. */
        #description
        {
            white-space: pre-wrap;
            margin-bottom: 12dp;
        }
        #description.mono
        {
            font-family: cata-mono;
        }
        #row
        {
            display: flex;
            align-items: center;
        }
        #label
        {
            margin-right: 8dp;
        }
        input.text
        {
            flex: 1 1 auto;
            min-width: 120dp;
            padding: 4dp 8dp;
            background-color: #0d1017;
            border: 1dp #39465c;
            border-radius: 4dp;
            color: #ffffff;
            caret-color: #ffffff;
            cursor: text;
        }
        input.text:focus
        {
            border-color: #5a7aa8;
        }
        input.text selection
        {
            background-color: #2b3a52;
            color: #ffffff;
        }
        /* Number popups only, and only when they have a step size. */
        #steps
        {
            display: flex;
            margin-left: 8dp;
        }
        #steps .step
        {
            width: 28dp;
            padding: 4dp 0;
            margin-left: 4dp;
            text-align: center;
            border-radius: 4dp;
            background-color: #232b3a;
        }
        /* Clicking one steps the value; see number_input_popup::query(). */
        #steps .step:hover
        {
            background-color: #2b3a52;
        }
    </style>
</head>
<body>
    <!-- Filled in by input_popup and its subclasses in src/input_popup.cpp. -->
    <div id="root">
        <div id="popup">
            <div id="title" class="hidden"></div>
            <div id="description" class="hidden"></div>
            <div id="row">
                <div id="label" class="hidden"></div>
                <input type="text" id="input"/>
                <div id="steps" class="hidden">
                    <div class="step">−</div>
                    <div class="step">+</div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
