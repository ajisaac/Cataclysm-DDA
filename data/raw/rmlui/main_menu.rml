<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="common.rcss"/>
    <style>
        body
        {
            background-color: #0b0d12;
        }
        .hidden
        {
            display: none;
        }
        #root
        {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24dp 16dp 12dp;
            box-sizing: border-box;
        }
        /* The ASCII art title and holiday decorations line up by spaces. */
        .art
        {
            font-family: cata-mono;
            white-space: pre;
        }
        #spider
        {
            position: absolute;
            left: 8dp;
            top: 8dp;
        }
        #graves
        {
            position: absolute;
            right: 8dp;
            bottom: 140dp;
        }
        #version
        {
            margin-top: 8dp;
        }
        /* MOTD and credits, or the selected tab's options, between the title
           and the menu bar. */
        #content
        {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: center;
            width: 100%;
            margin: 16dp 0;
        }
        #text-panel
        {
            display: flex;
            flex-direction: column;
            min-height: 0;
            width: 760dp;
            max-width: 100%;
            padding: 12dp 16dp;
            background-color: #141821f2;
            border: 1dp #39465c;
            border-radius: 8dp;
        }
        #text-title
        {
            font-size: 18dp;
            color: #ffffff;
            margin-bottom: 8dp;
        }
        /* Up and down, and the wheel, scroll it; see main_menu::opening_screen(). */
        #text
        {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            white-space: pre-wrap;
        }
        /* Hovering an option selects it and clicking picks it, as with the
           menu bar below. */
        #sub
        {
            min-width: 280dp;
            padding: 8dp;
            background-color: #141821f2;
            border: 1dp #39465c;
            border-radius: 8dp;
        }
        #sub .option
        {
            padding: 4dp 12dp;
            border-radius: 4dp;
            white-space: nowrap;
        }
        #sub .option.selected
        {
            background-color: #2b3a52;
        }
        #sub-position
        {
            margin-top: 4dp;
            font-size: 13dp;
            color: #6d7b92;
            text-align: right;
        }
        #menu
        {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }
        #menu .item
        {
            padding: 6dp 14dp;
            margin: 0 4dp 4dp;
            border-radius: 6dp;
            background-color: #1b2130;
            font-size: 18dp;
        }
        #menu .item.selected
        {
            background-color: #2b3a52;
        }
        #hint, #tip
        {
            margin-top: 8dp;
            text-align: center;
            max-width: 900dp;
        }
    </style>
</head>
<body>
    <!-- Filled in by main_menu in src/main_menu.cpp. -->
    <div id="spider" class="art hidden"></div>
    <div id="graves" class="art hidden"></div>
    <div id="root">
        <div id="title"></div>
        <div id="version"></div>
        <div id="content">
            <div id="text-panel" class="hidden">
                <div id="text-title"></div>
                <div id="text"></div>
            </div>
            <div id="sub-panel" class="hidden">
                <div id="sub"></div>
                <div id="sub-position" class="hidden"></div>
            </div>
        </div>
        <div id="menu"></div>
        <div id="hint"></div>
        <div id="tip"></div>
    </div>
</body>
</rml>
