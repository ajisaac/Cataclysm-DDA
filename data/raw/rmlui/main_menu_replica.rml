<rml>
<head>
    <title>Main menu replica</title>
    <link type="text/rcss" href="common.rcss"/>
    <style>
        #menu
        {
            position: absolute;
            top: 48dp;
            left: 48dp;
            width: 300dp;
            padding: 20dp;
            background-color: #141821f2;
            border: 1dp #39465c;
            border-radius: 12dp;
        }
        #menu .heading
        {
            font-size: 13dp;
            color: #6d7b92;
            margin-bottom: 14dp;
        }
        #menu .item
        {
            font-size: 19dp;
            padding: 7dp 12dp;
            margin-bottom: 2dp;
            border-radius: 6dp;
            color: #b7b2a4;
        }
        #menu .item.selected
        {
            background-color: #2b3a52;
            color: #ffffff;
        }
        #menu .item .key
        {
            color: #7fa8e0;
        }
        #menu .item.selected .key
        {
            color: #cfe2ff;
        }
    </style>
</head>
<body>
    <!-- Filled in by rml_ui::main_menu_replica::update(). -->
    <div id="menu">
        <div class="heading">RmlUi — main menu replica</div>
        <div id="items"></div>
    </div>
</body>
</rml>
