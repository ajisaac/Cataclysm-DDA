<rml>
<head>
    <title>Mutations</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
    <style>
        /* The mutations menu; see avatar::power_mutations() in src/mutation_ui.cpp. Passive and active mutations side by side, the examined one's description below. */
        #header
        {
            padding-bottom: 6dp;
            border-bottom: 1dp #39465c;
        }
        .mut-caption
        {
            margin-bottom: 4dp;
        }
        #mut-desc
        {
            flex: 0 0 auto;
            height: 120dp;
            margin-top: 6dp;
            padding-top: 4dp;
            overflow-y: auto;
            white-space: pre-wrap;
            border-top: 1dp #39465c;
        }
    </style>
</head>
<body>
    <!-- Filled in by avatar::power_mutations() in src/mutation_ui.cpp. -->
    <div id="root">
        <div id="window">
            <div id="titlebar">
                <div id="title"></div>
                <div id="close" data-action="QUIT">×</div>
            </div>
            <div id="tabs" class="hidden"></div>
            <div id="header" class="hidden"></div>
            <div id="body"></div>
            <div id="filter-row" class="hidden">
                <input type="text" id="filter" disabled="disabled"/>
            </div>
            <div id="footer" class="hidden"></div>
        </div>
    </div>
</body>
</rml>
