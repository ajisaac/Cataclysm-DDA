<rml>
<head>
    <title>Options</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
    <style>
        /* The options menu; see options_manager::show() in src/options.cpp.
           The selected option's tooltip in the header, its entries below. */
        #header
        {
            min-height: 120dp;
            padding-bottom: 6dp;
            border-bottom: 1dp #39465c;
        }
        .opt-note
        {
            margin-top: 6dp;
        }
        .opt-row
        {
            display: flex;
            align-items: center;
        }
        .opt-row.opt-head
        {
            margin-top: 2dp;
        }
        .opt-num
        {
            flex: 0 0 auto;
            width: 2.5em;
            color: #8d96a6;
            text-align: right;
            margin-right: 10dp;
        }
        .opt-name
        {
            flex: 1 1 auto;
            min-width: 0;
            overflow: hidden;
        }
        .opt-value
        {
            flex: 0 0 auto;
            width: 35%;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <!-- Filled in by options_manager::show() in src/options.cpp. -->
    <div id="root">
        <div id="window">
            <div id="titlebar">
                <div id="title"></div>
                <div id="close" data-action="QUIT">×</div>
            </div>
            <div id="tabs" class="hidden"></div>
            <div id="header" class="hidden"></div>
            <div id="body"></div>
            <div id="filter-row" class="hidden">
                <input type="text" id="filter" disabled="disabled"/>
            </div>
            <div id="footer" class="hidden"></div>
        </div>
    </div>
</body>
</rml>
